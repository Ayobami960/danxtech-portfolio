# Backend base URL, e.g. https://api.example.com
#
# Leave this EMPTY when the Admin host proxies /api and /socket.io to the API
# (same-origin mode). Cookies stay first-party, but static hosts cannot proxy
# WebSockets, so the realtime layer falls back to polling automatically.
#
# Set it to the API origin when Admin and API share a registrable domain
# (recommended): admin.example.com + api.example.com, with backend cookies
# using Domain=.example.com.
VITE_API_URL=http://localhost:8001

# Public portfolio URL used by "View site" and preview links.
VITE_CLIENT_URL=http://localhost:3000
