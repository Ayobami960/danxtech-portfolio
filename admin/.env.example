# Backend base URL. Leave this EMPTY (the default): the Admin host proxies
# /api and /socket.io to the API — the Vite dev server locally, the vercel.json
# rewrites in production — so requests are same-origin, the session cookie is
# first-party and no CORS is involved. WebSocket upgrades are not proxied, so
# the realtime layer falls back to polling automatically.
#
# Set it to an absolute origin only if the API is served from a different origin
# than the Admin (e.g. admin.example.com + api.example.com with backend cookies
# using Domain=.example.com). Never set it when the proxy rewrites are active.
VITE_API_URL=

# Public portfolio URL used by "View site" and preview links.
VITE_CLIENT_URL=http://localhost:3000
