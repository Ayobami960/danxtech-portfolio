PORT=8000
NODE_ENV=development

# Replace user, password and dbname with your own Postgres details
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/portfolio

# Client app first (used for chat links), admin app second. Both accept a
# comma-separated list; every entry must be a bare origin (scheme + host + port,
# no path or trailing slash). They are the CORS allowlist.
FRONTEND_ORIGIN_CLIENT=http://localhost:3000
FRONTEND_ORIGIN_ADMIN=http://localhost:5173

# Cookies and proxy hops.
#
# COOKIE_DOMAIN: leave EMPTY unless the apps and the API share a registrable
# domain (e.g. .example.com). A public suffix such as vercel.app cannot host a
# cookie, so setting it there makes the browser reject every session cookie.
COOKIE_DOMAIN=
# lax | strict | none. Use "none" when the frontend and the API are on different
# sites (two *.vercel.app projects are different sites). Browsers only accept
# SameSite=None together with Secure, so it is rejected outside NODE_ENV=production.
COOKIE_SAMESITE=lax
# Trusted proxy hops in front of the app: true | false | a hop count.
# Defaults to 1 in production (Vercel/Render/Railway each add one proxy hop).
TRUST_PROXY=

# Optional: the client's ISR webhook. When both are set, an admin mutation
# invalidates the matching client cache tag immediately instead of waiting for
# the 60-second revalidate window. The secret must match the client's
# REVALIDATE_SECRET. Leave FRONTEND_REVALIDATE_URL empty to disable.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# Auth secrets (each must be at least 32 characters)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=
IP_HASH_SALT=
TOTP_ENCRYPTION_KEY=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=adetoyedaniel2020@gmail.com
SMTP_PASS=YOUR_16_CHAR_GMAIL_APP_PASSWORD
MAIL_FROM=Danxtech <adetoyedaniel2020@gmail.com>
OWNER_EMAIL=adetoyedaniel2023@gmail.com

# Admin seed account
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Image storage.
#
# ImageKit is the only storage provider, in development and production. All
# three values are required: the server refuses to start without them, because
# there is no disk fallback (serverless hosts have a read-only, ephemeral
# filesystem). IMAGEKIT_URL_ENDPOINT is https://ik.imagekit.io/<your_imagekit_id>.
# The public key is only used by the ImageKit client constructor; uploads from
# this server are signed with the private key, which never leaves the backend.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Legacy alias for IMAGEKIT_URL_ENDPOINT, still accepted.
IMAGEKIT_END_POINT=
# Report database keys whose files are missing from ImageKit at startup.
# Defaults to true (false under NODE_ENV=test). Also available as npm run storage:check.
STORAGE_INTEGRITY_CHECK=true

# node -e "const c=require('crypto');const h=()=>c.randomBytes(32).toString('hex');console.log('JWT_ACCESS_SECRET='+h());console.log('JWT_REFRESH_SECRET='+h());console.log('CSRF_SECRET='+h());console.log('IP_HASH_SALT='+h());console.log('TOTP_ENCRYPTION_KEY='+c.randomBytes(32).toString('base64'))"