PORT=8000
NODE_ENV=development

# Replace user, password and dbname with your own Postgres details
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/portfolio

# Client app first (used for chat links), admin app second
FRONTEND_ORIGIN_CLIENT=http://localhost:3000
FRONTEND_ORIGIN_ADMIN=http://localhost:5173
PUBLIC_MEDIA_BASE_URL=http://localhost:8000

# Optional: the client's ISR webhook. When both are set, an admin mutation
# invalidates the matching client cache tag immediately instead of waiting for
# the 60-second revalidate window. The secret must match the client's
# REVALIDATE_SECRET. Leave FRONTEND_REVALIDATE_URL empty to disable.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# Auth secrets (each must be at least 32 characters)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=
IP_HASH_SALT=
TOTP_ENCRYPTION_KEY=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=adetoyedaniel2020@gmail.com
SMTP_PASS=YOUR_16_CHAR_GMAIL_APP_PASSWORD
MAIL_FROM=Danxtech <adetoyedaniel2020@gmail.com>
OWNER_EMAIL=adetoyedaniel2023@gmail.com

# Admin seed account
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ImageKit (set STORAGE_DRIVER=imagekit to use)
STORAGE_DRIVER=local
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_END_POINT=
# Report database keys whose files are missing from ImageKit at startup.
# Defaults to true (false under NODE_ENV=test). Also available as npm run storage:check.
STORAGE_INTEGRITY_CHECK=true

# node -e "const c=require('crypto');const h=()=>c.randomBytes(32).toString('hex');console.log('JWT_ACCESS_SECRET='+h());console.log('JWT_REFRESH_SECRET='+h());console.log('CSRF_SECRET='+h());console.log('IP_HASH_SALT='+h());console.log('TOTP_ENCRYPTION_KEY='+c.randomBytes(32).toString('base64'))"