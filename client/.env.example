# Base URL of the portfolio API.
# API_URL is used by Server Components; NEXT_PUBLIC_API_URL is inlined for the
# browser (the contact form POSTs directly to the API).
API_URL=http://localhost:8001
NEXT_PUBLIC_API_URL=https://portfolio-server-machine.vercel.app

# Must match REVALIDATE_SECRET in the backend's .env.
REVALIDATE_SECRET=e3bd33a34d219d71c7965f5db1b19ac48f38b78dbb049c860767a495784ab66d

# How the public site applies an admin change: "refetch" (default, in-place
# data refresh) or "reload" (overlay, then a full page reload).
NEXT_PUBLIC_UPDATE_MODE=refetch
